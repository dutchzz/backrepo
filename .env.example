# Environment
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
NEXT_PUBLIC_CASHAPP_CASHTAG='$NWOCOMINGSOON'

# Cloudflare R2 (file hosting — required for Vercel deploys)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=                 # e.g. https://files.yourdomain.com, or leave blank to use https://<bucket>.r2.dev
